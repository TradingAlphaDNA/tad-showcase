{
  "schema": "tad.csv-map.v1",
  "mapping_version": "chase-synthetic.v1",
  "role": "transactions",
  "header_record": 1,
  "metadata": {
    "source_broker": "chase",
    "account_ref": "0000",
    "account_name": "Synthetic Chase",
    "account_type": "brokerage",
    "currency": "USD",
    "timezone": ""
  },
  "defaults": {
    "asset_type": "equity",
    "multiplier": "1",
    "position_effect": "unknown",
    "amount_basis": "net_cash"
  },
  "columns": {
    "activity": {
      "column": "Type",
      "values": {
        "Buy": "buy",
        "Sell": "sell"
      }
    },
    "symbol": {
      "column": "Ticker"
    },
    "quantity": {
      "column": "Quantity",
      "number": "abs"
    },
    "price": {
      "column": "Price USD",
      "number": "plain"
    },
    "amount": {
      "column": "Amount USD",
      "number": "plain"
    },
    "commission": {
      "column": "Commissions USD",
      "number": "plain"
    },
    "trade_date": {
      "column": "Trade Date",
      "date_format": "%m/%d/%Y"
    },
    "post_date": {
      "column": "Post Date",
      "date_format": "%m/%d/%Y"
    },
    "settlement_date": {
      "column": "Settlement Date",
      "date_format": "%m/%d/%Y"
    },
    "account_ref": {
      "column": "Account Number"
    },
    "currency": {
      "column": "Local Currency"
    }
  },
  "rules": [],
  "exclusions": [],
  "assertions": [
    {
      "column": "Security Type",
      "equals": "Stock"
    }
  ]
}
